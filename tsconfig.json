{
  "compilerOptions": {
        "types": ["node"],
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
      "_helpers/*": ["_helpers/*"],
      "_middleware/*": ["_middleware/*"],
      "users/*": ["users/*"],
      "departments/*": ["departments/*"],
      "employees/*": ["employees/*"],
      "requests/*": ["requests/*"],
    }
  },
  "include": ["src/**/*", "_helper"],
  "exclude": ["node_modules", "dist"]
}